{
  "name": "ai-vtuber-framework-lite",
  "private": true,
  "version": "0.1.1",
  "description": "Local AI VTuber studio for Twitch chat, LLM replies, TTS and Live2D/VTube Studio.",
  "author": "Alvetore",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "tsup src/server/index.ts --format esm --target node20 --external better-sqlite3 --out-dir dist/server",
    "start": "electron .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "rebuild": "electron-builder install-app-deps",
    "test": "vitest run",
    "package:dir": "npm run build && electron-builder --dir",
    "package:dist": "npm run build && electron-builder"
  },
  "main": "src/electron/main.cjs",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@hookform/resolvers": "^5.9.2",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.45.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "openapi-types": "^12.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "gh-pages": "^5.0.0"
  },
  "build": {
    "appId": "com.aivtuber.frameworklite",
    "productName": "AI VTuber Framework Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "scripts/silero_server.py",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.py",
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": false
  }
}
