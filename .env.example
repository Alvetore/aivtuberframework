# Local development only. Saved values in the encrypted vault take priority.
TWITCH_OAUTH_TOKEN=
LLM_API_KEY=
OPENAI_TTS_API_KEY=
ELEVENLABS_API_KEY=
VTS_AUTH_TOKEN=
# Optional: use your own registered Twitch application for the login button.
TWITCH_CLIENT_ID=
TWITCH_REDIRECT_URI=
# Diagnostics retention in days (30 by default; 0 disables pruning).
VTUBER_OPERATION_RETENTION_DAYS=30
# Chat history retention in days (0 keeps messages forever).
VTUBER_MESSAGE_RETENTION_DAYS=0
# Optional standalone backend port; Electron manages its own backend port.
PORT=3001
